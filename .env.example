# Copy to .env (local only, never commit) for seeding:
# SUPABASE_URL=<url>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public values baked at build time (also set these in Netlify):
# VITE_SUPABASE_URL=<url>
# VITE_SUPABASE_ANON_KEY=<publishable-key>
# VITE_DESMOS_API_KEY=<desmos-api-key from desmos.com/my-api>
